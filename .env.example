LOG_LEVEL=info

# RabbitMQ broker the worker consumes its stage dispatches from and routes
# results back through. In a Hub deployment these are injected by Helm.
RABBITMQ_HOST=
RABBITMQ_EXCHANGE=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Queue this worker consumes "loitering" stage dispatches from. Defaults to
# kcloud-loitering-queue.fifo when unset.
LOITERING_QUEUE=kcloud-loitering-queue.fifo

# Queue the worker routes its loitering result back to (the workflows engine input).
WORKFLOWS_QUEUE=hub-workflows-queue
